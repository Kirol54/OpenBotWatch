def xterm_assets():
    """The folder with the xterm.js files, downloading and checking them the first time."""
    import base64, hashlib, io, tarfile, urllib.request
    with _xterm_lock:
        if all(os.path.isfile(os.path.join(XTERM_DIR, f)) for f in XTERM_FILES):
            return XTERM_DIR
        os.makedirs(XTERM_DIR, exist_ok=True)
        for pkg, ver, sha, files in XTERM:
            url = f"https://registry.npmjs.org/{pkg}/-/{pkg.split('/')[1]}-{ver}.tgz"
            with urllib.request.urlopen(url, timeout=60) as r:
                data = r.read(20 << 20)
            if base64.b64encode(hashlib.sha512(data).digest()).decode() != sha:
                raise RuntimeError(f"{pkg} {ver} from the npm registry doesn't match its known hash; not using it")
            with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as t:
                for f in files:
                    body = t.extractfile("package/" + f).read()
                    tmp = os.path.join(XTERM_DIR, os.path.basename(f) + ".part")
                    with open(tmp, "wb") as out:
                        out.write(body)
                    os.replace(tmp, os.path.join(XTERM_DIR, os.path.basename(f)))
        return XTERM_DIR


def ws_accept(key):
    import base64, hashlib
    return base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()


def ws_frame(data, opcode=2):
    n = len(data)
    head = bytes([0x80 | opcode]) + (bytes([n]) if n < 126 else struct.pack("!BH", 126, n) if n < 65536 else struct.pack("!BQ", 127, n))
    return head + data


def ws_read(sock):
    """One WebSocket message from the browser: (opcode, payload). Raises EOFError when the connection ends."""
    def exact(n):
        buf = b""
        while len(buf) < n:
            chunk = sock.recv(n - len(buf))
            if not chunk:
                raise EOFError
            buf += chunk
        return buf
    msg, first = b"", None
    while True:
        b0, b1 = exact(2)
        n = b1 & 0x7f
        if n == 126:
            n = struct.unpack("!H", exact(2))[0]
        elif n == 127:
            n = struct.unpack("!Q", exact(8))[0]
        if n > 1 << 20:
            raise EOFError
        mask = exact(4) if b1 & 0x80 else b"\0\0\0\0"
        data = bytes(c ^ mask[i % 4] for i, c in enumerate(exact(n)))
        op = b0 & 0x0f
        if op >= 8:                      # control frames may arrive between the parts of a message
            return op, data
        first = op if first is None else first
        msg += data
        if b0 & 0x80:
            return first, msg


def term_size(fd, cols, rows):
    import fcntl, termios
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", max(2, min(rows, 500)), max(2, min(cols, 1000)), 0, 0))


def stop_term(pid):
    """Stop a terminal program: politely, then for sure. Safe to call twice (two threads may)."""
    import signal
    try:
        for sig in (signal.SIGTERM, signal.SIGKILL):
            os.kill(pid, sig)
            end = time.time() + 1
            while time.time() < end:
                if os.waitpid(pid, os.WNOHANG)[0]:
                    return
                time.sleep(0.05)
    except (ProcessLookupError, ChildProcessError):   # already gone or already collected
        pass
    finally:
        _terms.discard(pid)


def run_term(sock, cols, rows):
    """Run btop on a pseudo-terminal and connect it to the browser's WebSocket until either side ends.
    Browser -> btop: binary messages are keystrokes and mouse input, text messages {"resize": [cols, rows]}."""
    import pty, select
    env = dict(os.environ, TERM="xterm-256color", COLORTERM="truecolor")
    if "UTF-8" not in (env.get("LC_ALL") or env.get("LC_CTYPE") or env.get("LANG") or "").upper().replace("UTF8", "UTF-8"):
        env["LANG"] = "C.UTF-8"
    pid, fd = pty.fork()
    if pid == 0:   # the child: becomes btop
        try:
            os.execvpe(TERM_CMD[0], TERM_CMD, env)
        finally:
            os._exit(127)
    _terms.add(pid)
    try:
        term_size(fd, cols, rows)
        while True:
            ready = select.select([sock, fd], [], [], 30)[0]
            if fd in ready:
                try:
                    out = os.read(fd, 1 << 16)
                except OSError:
                    out = b""
                if not out:   # btop quit
                    sock.sendall(ws_frame(struct.pack("!H", 1000) + b"btop exited", 8))
                    break
                sock.sendall(ws_frame(out))
            if sock in ready:
                op, data = ws_read(sock)
                if op == 8:
                    sock.sendall(ws_frame(data[:2], 8))
                    break
                if op == 9:
                    sock.sendall(ws_frame(data, 10))
                elif op == 2:
                    os.write(fd, data)
                elif op == 1:
                    try:
                        c, r = json.loads(data.decode())["resize"]
                        term_size(fd, int(c), int(r))
                    except (ValueError, KeyError, TypeError):
                        pass
    except (EOFError, OSError):
        pass
    finally:
        stop_term(pid)
        os.close(fd)


def lan_address():
    """(this machine's address, its local network) on the interface of the default route, e.g.
    (192.0.2.50, 192.0.2.0/24). Read from /proc/net/route, so no extra tools are needed."""
    rows = [line.split() for line in read("/proc/net/route").splitlines()[1:]]
    hexip = lambda h: ipaddress.IPv4Address(struct.pack("<I", int(h, 16)))
    default = [r for r in rows if r[1] == "00000000" and int(r[3], 16) & 2]   # destination 0.0.0.0, gateway flag
    if not default:
        raise SystemExit("obwatch: no default route, so no local network to listen on.")
    iface, gateway = default[0][0], hexip(default[0][2])
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:   # no packet is sent: this only picks the source address
        s.connect((str(gateway), 9))
        me = ipaddress.IPv4Address(s.getsockname()[0])
    for r in rows:
        if r[0] == iface and r[1] != "00000000":
            net = ipaddress.IPv4Network(f"{hexip(r[1])}/{hexip(r[7])}")
            if me in net:
                if not net.is_private:
                    raise SystemExit(f"obwatch: {net} on {iface} isn't a private network; refusing to listen there.")
                return me, net
    raise SystemExit(f"obwatch: couldn't find the local network of {iface}.")


def client_allowed(ip, network):
    """This machine always; otherwise only addresses inside the local network that --lan listens on."""
    client = ipaddress.ip_address(ip)
    return client.is_loopback or (network is not None and client in network)


class AccessLog:
    """Prints every connection attempt to the terminal. Refused requests and page loads are always shown;
    the page's live updates (a few a second) are summarized per browser once a minute."""

    def __init__(self, out=None):
        self.out = out or sys.stdout
        self.lock = threading.Lock()
        self.clients = set()
        self.ok = collections.Counter()
        self.flushed = time.time()

    def line(self, text):
        print(f"{time.strftime('%H:%M:%S')}  {text}", file=self.out, flush=True)

    def request(self, client, line, code, reason=""):
        with self.lock:
            if client not in self.clients:
                self.clients.add(client)
                self.line(f"{client:<15}  new client")
            path = line.split(" ")[1] if line.count(" ") >= 1 else line
            if code == 200 and path.startswith("/api/"):
                self.ok[client] += 1
            else:
                self.line(f"{client:<15}  {line or '(no request line)'}  → {code}{'  ' + reason if reason else ''}")
            if time.time() - self.flushed >= 60:
                for c, n in sorted(self.ok.items()):
                    self.line(f"{c:<15}  {n} live updates OK in the last minute")
                self.ok.clear()
                self.flushed = time.time()


def web_handler(state, token, port, address=None, network=None, log=None):
    from http.server import BaseHTTPRequestHandler
    from urllib.parse import parse_qs, urlparse
    hosts = {f"localhost:{port}", f"127.0.0.1:{port}", f"[::1]:{port}"}
    if address:
        hosts.add(f"{address}:{port}")

    log = log or AccessLog(open(os.devnull, "w"))
    cookie = f"obwatch_{port}"

    class Handler(BaseHTTPRequestHandler):
        reason = ""

        def log_message(self, *a):
            pass

        def log_request(self, code="-", size="-"):   # called for every response, including errors from http.server
            code = int(getattr(code, "value", code)) if str(getattr(code, "value", code)).isdigit() else 0
            line = self.requestline if self.requestline.isprintable() else repr(self.requestline)[:80]
            line = re.sub(r"token=[^&\s]+", "token=***", line)   # never print the token
            reason = self.reason
            if code == 400 and not self.requestline.startswith(("GET", "POST", "HEAD", "PUT", "DELETE", "OPTIONS")):
                reason = reason or "not an HTTP request: did the browser use https://? The link is http://"
            log.request(self.client_address[0], line, code, reason)

        def authorized(self):
            cookies = dict(c.strip().split("=", 1) for c in self.headers.get("Cookie", "").split(";") if "=" in c)
            given = self.headers.get("X-Obwatch-Token") or cookies.get(cookie, "")
            return hmac.compare_digest(given, token)

        def send(self, code, body, ctype="application/json", headers=(), cache="no-store"):
            data = body if isinstance(body, bytes) else json.dumps(body, default=str).encode()
            if code != 200 and isinstance(body, dict):
                self.reason = body.get("error", "")
            self.send_response(code)
            for k, v in headers:
                self.send_header(k, v)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", cache)
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.end_headers()
            self.wfile.write(data)

        def refused(self):
            """The checks every request passes first. Returns True after sending a refusal."""
            if not client_allowed(self.client_address[0], network):
                self.send(403, {"error": "only devices on the local network may connect"})
            elif self.headers.get("Host") not in hosts:   # blocks DNS-rebinding tricks from other web pages
                self.send(403, {"error": "wrong host"})
            else:
                return False
            return True

        def do_GET(self):
            if self.refused():
                return
            url = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(url.query).items()}
            if url.path == "/":
                if "token" in q:   # the printed link: keep the token in a cookie, then drop it from the address bar
                    if not hmac.compare_digest(q["token"], token):
                        self.reason = "wrong token in the link (obwatch makes a new one each time it starts)"
                        return self.send(200, WEB_PAGE.encode(), "text/html; charset=utf-8")
                    return self.send(303, b"", "text/plain", [
                        ("Location", "/"),
                        ("Set-Cookie", f"{cookie}={token}; Path=/; HttpOnly; SameSite=Strict")])
                return self.send(200, WEB_PAGE.encode(), "text/html; charset=utf-8")
            if not self.authorized():
                return self.send(403, {"error": "missing or wrong token: open the link obwatch printed"})
            try:
                since = int(q.get("since", "-1"))
            except ValueError:
                since = -1
            if url.path == "/api/agents":
                return self.send(200, state.agents_json())
            if url.path.startswith("/assets/"):
                return self.asset(url.path[8:])
            if url.path == "/term":
                return self.terminal(q)
            if url.path == "/api/agent":
                d = state.agent(q.get("id", ""), since, q.get("tab", ""))
            elif url.path == "/api/changes":
                d = state.changes(q.get("id", ""))
            elif url.path == "/api/log":
                d = state.log(q.get("id", ""), q.get("key", ""), since)
            elif url.path == "/api/file":
                d = state.file(q.get("id", ""), q.get("path", ""))
            else:
                d = None
            return self.send(200, d) if d is not None else self.send(404, {"error": "not found"})

        def asset(self, name):
            if name not in XTERM_FILES:
                return self.send(404, {"error": "not found"})
            try:
                folder = xterm_assets()
            except Exception as e:
                return self.send(502, {"error": f"couldn't get the terminal library (xterm.js): {e}"})
            ctype = "text/css" if name.endswith(".css") else "text/javascript"
            return self.send(200, read(os.path.join(folder, name), "rb"), ctype + "; charset=utf-8", cache="private, max-age=86400")

        def terminal(self, q):
            """The btop pane: a WebSocket to a pseudo-terminal running btop."""
            origin, host = self.headers.get("Origin", ""), self.headers.get("Host", "")
            if origin != f"http://{host}":   # only this page may open it, not a script on another site
                return self.send(403, {"error": f"terminal: wrong origin {origin!r}"})
            key = self.headers.get("Sec-WebSocket-Key")
            if self.headers.get("Upgrade", "").lower() != "websocket" or not key:
                return self.send(400, {"error": "terminal: not a WebSocket request"})
            if len(_terms) >= TERM_MAX:
                return self.send(429, {"error": f"terminal: {TERM_MAX} already open"})
            import shutil
            if not shutil.which(TERM_CMD[0]):
                return self.send(404, {"error": f"terminal: {TERM_CMD[0]} isn't installed on this machine"})
            try:
                cols, rows = int(q.get("cols", 120)), int(q.get("rows", 30))
            except ValueError:
                cols, rows = 120, 30
            self.send_response(101)
            self.send_header("Upgrade", "websocket")
            self.send_header("Connection", "Upgrade")
            self.send_header("Sec-WebSocket-Accept", ws_accept(key))
            self.end_headers()
            self.wfile.flush()
            self.close_connection = True
            log.line(f"{self.client_address[0]:<15}  terminal opened: {' '.join(TERM_CMD)} ({cols}x{rows})")
            started = time.time()
            run_term(self.connection, cols, rows)
            log.line(f"{self.client_address[0]:<15}  terminal closed after {ago(time.time() - started)}")

    return Handler


def web(port, lan=False):
    from http.server import ThreadingHTTPServer
    address, network = lan_address() if lan else (None, None)
    state = WebState()
    token = secrets.token_urlsafe(18)
    threading.Thread(target=state.run, daemon=True).start()
    server = ThreadingHTTPServer((str(address) if lan else "127.0.0.1", port),
                                 web_handler(state, token, port, address, network, AccessLog()))
    if lan:
        print(f"obwatch web is running on your local network only: {address}:{port}, open to devices in {network}.\n"
              f"It doesn't listen on other interfaces (VPN, Docker), and refuses clients outside {network}.\n\n"
              f"  Open:  http://{address}:{port}/?token={token}\n\n"
              f"Plain HTTP: anyone on this network who can watch its traffic could see the token.\n"
              f"If the page keeps loading on another device, a firewall here is probably dropping port {port}, e.g. for ufw:\n"
              f"  sudo ufw allow from {network} to {address} port {port} proto tcp\n"
              f"The link contains a secret token; don't share it. Ctrl-C stops the server.\n\n"
              f"Connection attempts:", flush=True)
    else:
        print(f"obwatch web is running on this machine only (127.0.0.1:{port}).\n\n"
              f"  Open:  http://localhost:{port}/?token={token}\n\n"
              f"From your own computer, forward the port over SSH first:\n"
              f"  ssh -L {port}:localhost:{port} <this server>\n"
              f"Or run `obwatch --web --lan` to open it to your local network instead.\n"
              f"The link contains a secret token; don't share it. Ctrl-C stops the server.\n\n"
              f"Connection attempts:", flush=True)
    import signal
    def bye(*_):   # closing the terminal or `kill` ends obwatch the same way as Ctrl-C
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGHUP, bye)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        for pid in list(_terms):   # don't leave a btop running after obwatch stops
            stop_term(pid)



