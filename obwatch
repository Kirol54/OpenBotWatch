#!/usr/bin/env python3
"""obwatch - watch one OpenBot agent: its reasoning, its commands, and the live
output of everything it runs (foreground commands, background jobs, and
detached processes such as servers writing to log files). Works with agents on
the Claude Code and opencode providers (opencode covers local LLMs too).

  obwatch                 pick an agent from a list
  obwatch coder           open the agent whose name contains "coder"
  obwatch coder -f FILE   also pin FILE as a tab
  obwatch coder --plain   no TUI, just stream the activity feed

Keys:  Tab/Shift-Tab or <-/->/1-9 switch tabs   Up/Down/PgUp/PgDn/g scroll
       G or End follow   e expand outputs   s subagent lines in Activity
       x / X close tab / all finished tabs
       a agent list      q quit
"""
__version__ = "0.2.1"

import argparse, collections, curses, datetime as dt, glob, json, locale, os, re, sqlite3, sys, tempfile, time

HOME = os.path.expanduser("~")
PROJECTS = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude"), "projects")
DB = os.path.join(HOME, ".config/OpenBot/openbot.db")
SIDEBAR = os.path.join(HOME, ".config/OpenBot/openbot-sidebar-layout-v1.json")
OC_DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "opencode")
if not os.path.exists(os.path.join(OC_DATA, "opencode.db")):
    OC_DATA = os.path.join(HOME, ".local/share/opencode")
OC_DB = os.path.join(OC_DATA, "opencode.db")
HARNESSES = {"claude", "opencode"}     # programs that run the agent itself
PAGE = os.sysconf("SC_PAGE_SIZE")
SHELLS = {"sh", "bash", "zsh", "dash", "nohup", "setsid", "timeout", "env", "stdbuf", "nice", "sudo", "xargs", "time"}
UTILS = {"sleep", "cat", "tail", "head", "grep", "sed", "awk", "tee", "wc", "sort", "uniq", "cut", "tr", "echo", "printf", "date", "ls", "find", "xargs", "pgrep", "ps"}
SUBCMD = {"docker", "cargo", "npm", "pnpm", "yarn", "git", "go", "make", "python", "python3", "node", "uv", "pip", "npx", "kubectl"}
CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")   # control bytes (NULs from truncated logs, binary output)
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07|\x1b[()][A-Z0-9]")
LOGLIKE = re.compile(r"\.(log|out|output|txt)$")
TASK_ID = re.compile(r"(?:with ID: |\(task )([a-z0-9]{6,})")
OPENBOT_TAGS = re.compile(r"<openbot-[\w-]+>.*?</openbot-[\w-]+>\s*", re.S)
SNAPSHOT_CMD = re.compile(r"eval '(.*)'(?: < /dev/null)? && pwd -P", re.S)   # Claude Code's wrapper around each Bash command
TICKS = os.sysconf("SC_CLK_TCK")
KEEP_DONE = 15 * 60      # finished tabs stay this long
KEEP_GONE = 10           # ...unless their file was deleted (finished foreground commands)
MAX_DONE = 12            # at most this many finished tabs; oldest are dropped first
FRAME_MS = 300           # redraw and read new activity this often
SCAN_EVERY = 1.5         # seconds between process scans
BACKLOG_HOURS = 48       # Claude Code: replay session files written this recently
OC_BACKLOG = 200         # opencode: replay this many recent messages
TOOL_STALE = 11 * 60     # a tool call with no result after this long is no longer shown as running
MODEL_STALE = 30 * 60    # same for a model turn that never completed
SAME_START = 3           # seconds: an opencode command and its output file start this close together


def read(path, mode="r"):
    with open(path, mode) as f:
        return f.read()


def boot_time():
    for line in read("/proc/stat").splitlines():
        if line.startswith("btime"):
            return int(line.split()[1])
    return 0


BOOT = boot_time()


def ago(sec):
    sec = int(max(sec, 0))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m"
    if sec < 86400:
        return f"{sec // 3600}h{sec % 3600 // 60:02d}m"
    return f"{sec // 86400}d"


# ---------------------------------------------------------------- agents

def ro_db(path):
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2)


class OcDB:
    """Shared read-only connection to opencode's session database."""
    conn = None

    @classmethod
    def q(cls, sql, args=()):
        if not os.path.exists(OC_DB):
            return []
        try:
            if cls.conn is None:
                cls.conn = ro_db(OC_DB)
            return cls.conn.execute(sql, tuple(args)).fetchall()
        except sqlite3.Error:
            cls.conn = None
            return []


def marks(n):
    return ",".join("?" * n)


class Agent:
    """An OpenBot agent. Subclasses know where their harness keeps sessions and command output."""
    kind = "?"

    def __init__(self, aid, d):
        self.id, self.name = aid, d.get("name") or aid
        self.title = d.get("title") or ""
        self.provider = d.get("provider") or "?"
        self.workspace = d.get("workspacePath") or os.path.join(HOME, "OpenBot/Agents", aid)
        self.projdir = os.path.join(PROJECTS, re.sub(r"[^A-Za-z0-9]", "-", self.workspace))
        self._written = (0, 0)

    @property
    def supported(self):
        return False

    def sessions(self):
        return set()

    def _last_write(self):
        return 0

    def last_write(self):
        """When the agent's session last changed. Cached briefly: the header asks on every frame."""
        if time.time() - self._written[0] > 1:
            self._written = (time.time(), self._last_write())
        return self._written[1]

    def output_files(self):
        """Output files of the agent's background and foreground commands."""
        return []

    def make_feed(self):
        return None

    def extra_procs(self, procs, keep):
        """Processes that belong to the agent but can't be found by their session variable."""
        return []

    def subagents(self):
        return []


class ClaudeAgent(Agent):
    kind = "claude"
    supported = True

    def sessions(self):
        return {os.path.basename(p)[:-6] for p in glob.glob(os.path.join(self.projdir, "*.jsonl"))}

    def _last_write(self):
        ts = []
        for p in glob.glob(os.path.join(self.projdir, "**/*.jsonl"), recursive=True):
            try:
                ts.append(os.path.getmtime(p))
            except OSError:
                pass
        return max(ts, default=0)

    def subagents(self):
        """The agent's subagents, as dicts: key (the feed's `src` for its events), label, kind, finished,
        started, updated, where. Claude Code writes <session>/subagents/agent-*.jsonl with a .meta.json
        next to it (description, agentType, and finished: true when done)."""
        res = []
        for f in glob.glob(os.path.join(self.projdir, "*", "subagents", "agent-*.jsonl")):
            meta_file = f[:-6] + ".meta.json"
            try:
                updated = os.path.getmtime(f)
                started = os.path.getctime(meta_file) if os.path.exists(meta_file) else updated
                meta = json.loads(read(meta_file)) if os.path.exists(meta_file) else {}
            except (OSError, ValueError):
                continue
            res.append(dict(key=f, label=meta.get("description") or os.path.basename(f)[:-6],
                            kind=meta.get("agentType") or "subagent", finished=bool(meta.get("finished")),
                            started=started, updated=updated, where=f))
        return res

    def output_files(self):
        name = os.path.basename(self.projdir)
        files = glob.glob(f"{tempfile.gettempdir()}/claude-{os.getuid()}/{name}/*/tasks/*.output")
        # a background subagent's task file is a link to its transcript: it has a subagent tab instead
        return [f for f in files if not os.path.islink(f) or not os.readlink(f).endswith(".jsonl")]

    def make_feed(self):
        return Feed(self)


class OpencodeAgent(Agent):
    kind = "opencode"
    supported = True

    def __init__(self, aid, d):
        super().__init__(aid, d)
        self.mapped = set()            # session ids that OpenBot recorded for this agent
        self._cache = (0, set())

    def sessions(self):
        if time.time() - self._cache[0] < 3:
            return self._cache[1]
        ids = {r[0] for r in OcDB.q("select id from session_v2 where directory = ?", (self.workspace,))} | self.mapped
        frontier = set(ids)
        while frontier:   # subagent sessions
            kids = {r[0] for r in OcDB.q(f"select id from session_v2 where parent_id in ({marks(len(frontier))})",
                                          frontier)} - ids
            ids |= kids
            frontier = kids
        self._cache = (time.time(), ids)
        return ids

    def _last_write(self):
        ids = self.sessions()
        if not ids:
            return 0
        r = OcDB.q(f"select max(time_updated) from session_v2 where id in ({marks(len(ids))})", ids)
        return (r[0][0] or 0) / 1000 if r else 0

    def shell_dirs(self):
        """opencode writes each shell command's output to shell/<project id>/sh_*.out"""
        ids = self.sessions()
        pids = {r[0] for r in OcDB.q("select id from project where worktree = ?", (self.workspace,))}
        if ids:
            pids |= {r[0] for r in OcDB.q(f"select project_id from session_v2 where id in ({marks(len(ids))})", ids)}
        return [os.path.join(OC_DATA, "shell", p) for p in pids if p]

    def output_files(self):
        return [f for d in self.shell_dirs() for f in glob.glob(os.path.join(d, "sh_*.out"))]

    def command_starts(self, within=KEEP_DONE):
        """[(time, sh_*.out)] for the agent's recent shell commands: opencode creates the file as it starts one."""
        now, res = time.time(), []
        for f in self.output_files():
            try:
                c = os.path.getctime(f)
            except OSError:
                continue
            if now - c < within:
                res.append((c, f))
        return res

    def extra_procs(self, procs, keep):
        """Commands opencode started for this agent that lost OPENCODE_SESSION_ID (e.g. `env -i ...`):
        direct children of opencode that started together with one of the agent's sh_*.out files.
        Commands can run for hours, so all of the agent's output files count here."""
        starts = [c for c, _ in self.command_starts(within=float("inf"))]
        res = []
        for p in procs.values():
            par = procs.get(p["ppid"])
            if (p["pid"] not in keep and not p["sid"] and par and base(par) == "opencode"
                    and any(abs(c - p["start"]) < SAME_START for c in starts)):
                res.append(p)
        return res

    def subagents(self):
        """Child sessions (opencode's subagents). A session is busy until its time_idle passes its time_busy."""
        ids = self.sessions()
        if not ids:
            return []
        rows = OcDB.q(f"select id, title, agent, time_created, time_updated, time_busy, time_idle from session_v2 "
                      f"where id in ({marks(len(ids))}) and parent_id in ({marks(len(ids))})", [*ids, *ids])
        res = []
        for sid, title, kind, created, updated, busy, idle in rows:
            res.append(dict(key=sid, label=title or sid, kind=kind or "subagent",
                            finished=bool(idle and idle >= (busy or 0)), started=(created or 0) / 1000,
                            updated=(updated or 0) / 1000, where=f"opencode session {sid}"))
        return res

    def make_feed(self):
        return OcFeed(self)


AGENT_KINDS = {"claude": ClaudeAgent, "opencode": OpencodeAgent}


def make_agent(aid, d):
    return AGENT_KINDS.get(d.get("provider"), Agent)(aid, d)


def sidebar_order(agents, layout):
    """Agents in the order of OpenBot's sidebar: section by section, each in the sidebar's agent order.
    Agents the layout doesn't mention keep their place after the ones it does."""
    order = layout.get("agentOrder") or []
    rank = {aid: i for i, aid in enumerate(order)}
    assigned = layout.get("agentAssignments") or {}
    sections = []
    for sec in layout.get("order") or []:
        sid = sec.get("id") if isinstance(sec, dict) else sec
        if sid not in sections:
            sections.append(sid)
    for sec in layout.get("sections") or []:
        sid = sec.get("id") if isinstance(sec, dict) else sec
        if sid not in sections:
            sections.append(sid)

    def key(ia):
        i, a = ia
        sec = assigned.get(a.id) or "unassigned"
        pos = sections.index(sec) if sec in sections else len(sections)
        return (pos, rank.get(a.id, len(order) + i))
    return [a for _, a in sorted(enumerate(agents), key=key)]


def load_agents():
    rows, threads, sessions = [], [], []
    try:
        db = ro_db(DB)
        rows = db.execute("select agent_id, agent_json from projection_agents order by sort_order").fetchall()
        try:
            threads = db.execute("select thread_id, agent_id from projection_agent_threads").fetchall()
            sessions = db.execute("select thread_id, external_session_id from projection_provider_sessions "
                                  "where provider = 'opencode'").fetchall()
        except sqlite3.Error:
            pass
        db.close()
    except Exception:
        pass
    agents = [make_agent(aid, json.loads(j)) for aid, j in rows]
    owner = {f"openbot-thread-{a.id}": a for a in agents}
    owner.update({t: a for a in agents for t, aid in threads if aid == a.id})
    for t, sid in sessions:
        if t in owner and sid and isinstance(owner[t], OpencodeAgent):
            owner[t].mapped.add(sid)
    try:
        agents = sidebar_order(agents, json.loads(read(SIDEBAR)))
    except (OSError, ValueError, AttributeError, TypeError):
        pass   # keep OpenBot's stored order
    known = {a.projdir for a in agents}
    for d in glob.glob(os.path.join(PROJECTS, "*")):   # transcripts without an OpenBot agent
        if d not in known and glob.glob(os.path.join(d, "*.jsonl")):
            a = ClaudeAgent(os.path.basename(d), {"name": os.path.basename(d)[-28:], "provider": "claude"})
            a.projdir = d
            agents.append(a)
    return agents


# ---------------------------------------------------------------- processes

def scan_procs():
    procs, uid = {}, os.getuid()
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            if os.stat(f"/proc/{d}").st_uid != uid:
                continue
            st = read(f"/proc/{d}/stat", "rb").decode("utf-8", "replace")
            f = st[st.rindex(")") + 2:].split()
            cmd = [c.decode("utf-8", "replace") for c in read(f"/proc/{d}/cmdline", "rb").split(b"\0") if c]
            env = read(f"/proc/{d}/environ", "rb")
        except (OSError, ValueError):
            continue
        if not cmd:
            continue
        m = (re.search(rb"(?:^|\0)OPENCODE_SESSION_ID=([^\0]+)", env)
             or re.search(rb"(?:^|\0)CLAUDE_CODE_SESSION_ID=([^\0]+)", env))
        try:
            out = os.readlink(f"/proc/{d}/fd/1")
        except OSError:
            out = None
        try:
            unit = read(f"/proc/{d}/cgroup").strip().rsplit("/", 1)[-1]
        except OSError:
            unit = ""
        procs[int(d)] = dict(pid=int(d), ppid=int(f[1]), cmd=cmd, start=BOOT + int(f[19]) / TICKS,
                             sid=m.group(1).decode() if m else None, cpu=int(f[11]) + int(f[12]),
                             rss=int(f[21]) * PAGE, out=out, unit=unit, unbuffered=b"PYTHONUNBUFFERED=" in env)
    return procs


def base(p):
    return os.path.basename(p["cmd"][0])


def is_harness(p):
    return base(p) in HARNESSES


def is_shell(p):
    return base(p) in SHELLS


def unit_arg(cmd):
    for i, a in enumerate(cmd):
        if a.startswith("--unit="):
            return a[7:]
        if a in ("--unit", "-u") and i + 1 < len(cmd):
            return cmd[i + 1]
    return None


def agent_procs(procs, sessions, agent=None):
    """Processes started by the agent's commands (incl. detached ones), minus MCP servers.

    Programs started through `systemd-run` run outside the agent's process tree and lose its
    environment; they are found by their systemd unit, or by sharing systemd-run's output pipe."""
    keep = {}
    for p in procs.values():
        if p["sid"] not in sessions or is_harness(p):
            continue
        q, ok = p, True
        while True:
            par = procs.get(q["ppid"])
            if par is None:
                break
            if is_harness(par):
                # The shell tool runs a shell; Claude Code's other direct children are MCP servers.
                # opencode only marks shell commands, and a shell running one command `exec`s it,
                # so under opencode the command itself can be the direct child.
                ok = is_shell(q) or base(par) == "opencode"
                break
            q = par
        if ok:
            keep[p["pid"]] = p
    if agent is not None:
        keep.update((p["pid"], p) for p in agent.extra_procs(procs, keep))
    # Children of the agent's processes are the agent's too, even when they were started with a
    # cleaned environment (e.g. by a test runner or `systemd-run`) and lost the session variable.
    kids = collections.defaultdict(list)
    for p in procs.values():
        kids[p["ppid"]].append(p)
    todo = list(keep)
    while todo:
        for k in kids.get(todo.pop(), []):
            if k["pid"] not in keep and not is_harness(k):
                keep[k["pid"]] = k
                todo.append(k["pid"])
    units, pipes = set(), set()
    for p in keep.values():
        if base(p) == "systemd-run":
            u = unit_arg(p["cmd"])
            if u:
                units |= {u, u + ".service", u + ".scope"} if "." not in u else {u}
            elif p["out"] and p["out"].startswith(("pipe:", "socket:")):
                pipes.add(p["out"])
    if units or pipes:
        for p in procs.values():
            if p["pid"] not in keep and (p["unit"] in units or (p["out"] in pipes and p["ppid"] not in keep)):
                keep[p["pid"]] = dict(p, via="systemd-run")
    return list(keep.values())


def proc_fds(pid):
    """[(fd, target)] of a process's open files, pipes and sockets."""
    try:
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return []
    res = []
    for fd in fds:
        try:
            res.append((fd, os.readlink(f"/proc/{pid}/fd/{fd}")))
        except OSError:
            pass
    return res


def fd_writable(pid, fd):
    """Whether the process opened `fd` for writing (None if unknown)."""
    try:
        return bool(int(read(f"/proc/{pid}/fdinfo/{fd}").split("flags:")[1].split()[0], 8) & 3)
    except (OSError, IndexError, ValueError):
        return None


def out_files(pid):
    """Regular files a process writes to: its stdout/stderr, plus log-like files open for writing."""
    res = set()
    for fd, t in proc_fds(pid):
        if not t.startswith("/") or t.startswith(("/dev/", "/proc/", "/sys/")) or t.endswith(" (deleted)"):
            continue
        if fd in ("1", "2") or (LOGLIKE.search(t) and fd_writable(pid, fd)):
            res.add(t)
    return {t for t in res if os.path.isfile(t)}


def proc_label(ps):
    for p in sorted(ps, key=lambda p: p["start"]):
        if is_shell(p) or base(p) in UTILS:
            continue
        b = base(p)
        args = [a for a in p["cmd"][1:] if not a.startswith("-")]
        if b in SUBCMD and args:
            b += " " + os.path.basename(args[0])
        return b
    return None


def agent_jobs(aps):
    by_file = collections.defaultdict(list)
    for p in aps:
        for f in out_files(p["pid"]):
            by_file[f].append(p)
    return by_file


def harness_writing(procs, dirs):
    """opencode writes a running command's output to its sh_*.out file itself: find those open files."""
    res = set()
    if not dirs:
        return res
    for p in procs.values():
        if base(p) == "opencode":
            res |= {t for _, t in proc_fds(p["pid"]) if t.endswith(".out") and t.startswith(dirs)}
    return res


def shell_arg(p):
    c = p["cmd"]
    return c[c.index("-c") + 1] if is_shell(p) and "-c" in c[:-1] else None


def task_id(f):
    b = os.path.basename(f)
    if f.endswith(".output") and "/tasks/" in f:
        return b[:-7]
    if f.endswith(".out") and b.startswith("sh_"):
        return b[:-4]
    return None


def started_at(f, ps):
    if ps:
        return min(p["start"] for p in ps)
    try:
        return os.path.getctime(f)
    except OSError:
        return time.time()


def pretty_cmd(cmd):
    s = " ".join(cmd)
    m = SNAPSHOT_CMD.search(s)
    if m:
        s = f"{os.path.basename(cmd[0])} -c {m.group(1)}".replace("'\"'\"'", "'")
    return s.replace("\n", " ⏎ ").replace("\t", " ")


def fmt_mem(n):
    for unit in ("B", "K", "M", "G"):
        if n < 1024 or unit == "G":
            return f"{n:.0f}{unit}" if unit in ("B", "K") else f"{n:.1f}{unit}"
        n /= 1024


# ---------------------------------------------------------------- activity feed

class Feed:
    def __init__(self, agent):
        self.agent = agent
        self.pos, self.part = {}, {}
        self.events = collections.deque(maxlen=4000)
        self.total = 0
        self.tools, self.task_desc, self.pending = {}, {}, collections.OrderedDict()
        self.primed = False
        self.ctx = {}   # epoch, src (session file) and side (subagent?) of the record being read

    def poll(self):
        files = glob.glob(os.path.join(self.agent.projdir, "**/*.jsonl"), recursive=True)
        cutoff = time.time() - BACKLOG_HOURS * 3600
        for p in sorted(files, key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0):
            try:
                size, mtime = os.path.getsize(p), os.path.getmtime(p)
            except OSError:
                continue
            if p not in self.pos:
                self.pos[p] = 0 if (not self.primed and mtime >= cutoff) or self.primed else size
            if size < self.pos[p]:
                self.pos[p] = 0
            if size == self.pos[p]:
                continue
            with open(p, "rb") as f:
                f.seek(self.pos[p])
                data = f.read(16 << 20)
            self.pos[p] += len(data)
            lines = (self.part.pop(p, b"") + data).split(b"\n")
            if lines[-1]:
                self.part[p] = lines[-1]
            for line in lines[:-1]:
                try:
                    self.add(json.loads(line), p)
                except (ValueError, AttributeError):
                    pass
        self.primed = True

    def ev(self, ts, kind, text, **kw):
        self.events.append(dict(self.ctx, ts=ts, kind=kind, text=text, **kw))
        self.total += 1

    def add(self, rec, src=None):
        t = rec.get("type")
        if t not in ("user", "assistant"):
            return
        ts, epoch = "", time.time()
        try:
            u = dt.datetime.fromisoformat(rec["timestamp"].replace("Z", "+00:00")).astimezone()
            ts, epoch = u.strftime("%H:%M:%S"), u.timestamp()
        except (KeyError, ValueError):
            pass
        side = bool(rec.get("isSidechain"))
        self.ctx = dict(epoch=epoch, src=src, side=side)
        content = (rec.get("message") or {}).get("content")
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        for b in content or []:
            bt = b.get("type")
            if t == "user" and bt == "text":
                if not rec.get("isMeta"):
                    self.ev(ts, "msg", b.get("text", ""), side=side)
            elif bt == "text":
                if b.get("text", "").strip():
                    self.ev(ts, "say", b["text"].strip(), side=side)
            elif bt in ("thinking", "redacted_thinking"):
                self.ev(ts, "think", (b.get("thinking") or "").strip(), side=side)
            elif bt == "tool_use":
                name, inp = b.get("name", "?"), b.get("input") or {}
                self.tools[b.get("id")] = (name, inp)
                if name == "Bash":
                    self.ev(ts, "cmd", inp.get("command", ""), desc=inp.get("description", ""),
                            bg=bool(inp.get("run_in_background")), side=side)
                    label = inp.get("description") or short_cmd(inp.get("command", ""))
                else:
                    self.ev(ts, "tool", tool_detail(name, inp), name=name.split("__")[-1], side=side)
                    label = name.split("__")[-1]
                self.pending[b.get("id")] = (epoch, label, name)
            elif bt == "tool_result":
                tid = b.get("tool_use_id")
                self.pending.pop(tid, None)
                name, inp = self.tools.get(tid, ("?", {}))
                c = b.get("content")
                if isinstance(c, list):
                    c = "\n".join(x.get("text", f"[{x.get('type')}]") for x in c)
                c = (c or "").strip()
                m = TASK_ID.search(c[:300])
                if m:
                    self.task_desc[m.group(1)] = inp.get("description") or short_cmd(inp.get("command", "")) or name
                self.ev(ts, "err" if b.get("is_error") else "out", c or "(no output)", name=name, side=side)

    def running(self):
        """(started, label, tool) of tool calls still waiting for their result."""
        now = time.time()
        return [v for v in self.pending.values() if now - v[0] < (MODEL_STALE if v[2] == "model" else TOOL_STALE)]

    def rows(self, expand, src=None, main_only=False):
        """-> list of (ts, tag, style, text), oldest first. `src`: only that session file (a subagent);
        `main_only`: leave out subagents."""
        out = []
        events = sorted(self.events, key=lambda e: e.get("epoch") or 0)   # files are read one at a time
        for e in events:
            if (src and e.get("src") != src) or (main_only and e.get("side")):
                continue
            k, ts, pre = e["kind"], e["ts"], "↳" if e.get("side") and not src else ""
            if k == "msg":
                out.append((ts, pre + "IN", "msg", e["text"] if expand else clip(e["text"], 6)))
            elif k == "say":
                out.append((ts, pre + "SAY", "say", e["text"]))
            elif k == "think":
                if e["text"]:
                    out.append((ts, pre + "THINK", "think", e["text"] if expand else clip(e["text"], 15)))
                elif expand:
                    out.append((ts, pre + "THINK", "dim", "(thinking not recorded)"))
            elif k == "cmd":
                if e["desc"]:
                    out.append((ts, pre + "#", "dim", e["desc"] + ("   [background]" if e["bg"] else "")))
                out.append((ts, pre + "$", "cmd", e["text"]))
            elif k == "tool":
                out.append((ts, pre + "TOOL", "tool", f"{e['name']}  " + (e["text"] if expand else clip(e["text"], 3))))
            else:
                n = 14 if e.get("name") == "Bash" else 3
                out.append((ts, pre + ("ERR" if k == "err" else "│"), "err" if k == "err" else "out",
                            e["text"] if expand else clip(e["text"], n)))
        return out


def unquote(cmd):
    return re.sub(r"[\"'\s]+", " ", cmd).strip()


def short_cmd(cmd, n=60):
    """A command as a one-line label."""
    first = cmd.strip().split("\n")[0]
    return (first[:n] + "…") if len(first) > n or "\n" in cmd.strip() else first


def tool_detail(name, inp):
    n = name.lower()
    if n in ("read", "write", "edit", "notebookedit", "patch", "list", "multiedit"):
        return inp.get("file_path") or inp.get("path") or inp.get("filePath") or ""
    if n in ("grep", "glob"):
        return f"{inp.get('pattern', '')}  {inp.get('path', '')}"
    if n == "monitor":
        return f"{inp.get('description', '')}\n{inp.get('command', '')}"
    if n in ("agent", "task"):
        return f"{inp.get('description', '')}: {inp.get('prompt', '')}"
    if n == "execute":          # opencode Code Mode: JavaScript that calls tools
        return inp.get("code", "")
    if n == "skill":
        return inp.get("id") or inp.get("name") or ""
    return json.dumps(inp, ensure_ascii=False)


class OcFeed(Feed):
    """Activity of an opencode agent (any model, local LLMs included), read from opencode's database."""

    def __init__(self, agent):
        super().__init__(agent)
        self.since = 0
        self.done = set()                      # (message id, part index, stage) already shown
        self.seen = {}                         # message id -> time_updated last parsed
        self.bg_shells, self.shell_cmd = set(), {}

    def poll(self):
        sids = self.agent.sessions()
        if not sids:
            return
        roots = {r[0] for r in OcDB.q(f"select id from session_v2 where id in ({marks(len(sids))}) and "
                                      f"(parent_id is null or parent_id not in ({marks(len(sids))}))", [*sids, *sids])}
        sql = (f"select id, type, time_created, time_updated, data, session_id from session_message "
               f"where session_id in ({marks(len(sids))}) and type in ('user', 'assistant', 'synthetic') ")
        if self.primed:
            rows = OcDB.q(sql + "and time_updated >= ? order by time_created, seq", [*sids, self.since])
        else:   # start with the last messages, however old
            rows = OcDB.q(sql + f"order by time_created desc, seq desc limit {OC_BACKLOG}", sids)[::-1]
        for mid, typ, created, updated, data, sid in rows:
            self.ctx = dict(epoch=(created or 0) / 1000, src=sid, side=sid not in roots)
            self.since = max(self.since, updated or 0)
            if self.seen.get(mid) == updated:
                continue   # unchanged since the last poll
            self.seen[mid] = updated
            try:
                self.add_msg(mid, typ, created or 0, json.loads(data))
            except (ValueError, AttributeError, TypeError):
                pass
        self.primed = True

    @staticmethod
    def stamp(ms):
        return time.strftime("%H:%M:%S", time.localtime(ms / 1000)), ms / 1000

    def add_msg(self, mid, typ, created, j):
        if typ in ("user", "synthetic"):
            if (mid, 0, "in") not in self.done:
                self.done.add((mid, 0, "in"))
                text = OPENBOT_TAGS.sub("", j.get("text") or "").strip()
                self.ev(self.stamp(created)[0], "msg", text or "(OpenBot instructions)")
            return
        mtime = j.get("time") or {}
        if mtime.get("completed") or j.get("error"):
            self.pending.pop(mid, None)
        elif not any(p.get("type") == "tool" and (p.get("state") or {}).get("status") == "running"
                     for p in j.get("content") or []):
            self.pending[mid] = (created / 1000, "waiting for the model", "model")   # e.g. a local model still generating
        else:
            self.pending.pop(mid, None)
        last = created
        for i, part in enumerate(j.get("content") or []):
            pt, ptime = part.get("type"), part.get("time") or {}
            last = ptime.get("completed") or ptime.get("created") or last   # text parts carry no time of their own
            ts, epoch = self.stamp(ptime.get("created") or last)
            if pt in ("reasoning", "text"):
                if (mid, i, "t") in self.done or not (mtime.get("completed") or ptime.get("completed")):
                    continue
                self.done.add((mid, i, "t"))
                text = (part.get("text") or "").strip()
                if text:
                    self.ev(ts, "think" if pt == "reasoning" else "say", text)
            elif pt == "tool":
                self.tool_part(mid, i, part, ts, epoch)
        err = j.get("error")
        if err and mtime.get("completed") and (mid, -1, "err") not in self.done:
            self.done.add((mid, -1, "err"))
            self.ev(self.stamp(mtime["completed"])[0], "err", f"{err.get('type', 'error')}: {err.get('message', '')}")

    def tool_part(self, mid, i, part, ts, epoch):
        name, st = part.get("name", "?"), part.get("state") or {}
        inp, status, meta = st.get("input") or {}, st.get("status"), st.get("metadata") or {}
        shell = name in ("shell", "bash")
        key = part.get("id") or f"{mid}:{i}"
        if meta.get("shellID"):
            sh = meta["shellID"]
            self.task_desc[sh] = inp.get("description") or short_cmd(inp.get("command", ""))
            self.shell_cmd[sh] = inp.get("command", "")
            if inp.get("background"):
                self.bg_shells.add(sh)
        if (mid, i, "use") not in self.done and (inp or status in ("running", "completed", "error")):
            self.done.add((mid, i, "use"))
            if shell:
                self.ev(ts, "cmd", inp.get("command", ""), desc=inp.get("description", ""), bg=bool(inp.get("background")))
                self.pending[key] = (epoch, inp.get("description") or short_cmd(inp.get("command", "")), "Bash")
            else:
                self.ev(ts, "tool", tool_detail(name, inp), name=name)
                self.pending[key] = (epoch, name, name)
        if status in ("completed", "error") and (mid, i, "res") not in self.done:
            self.done.add((mid, i, "res"))
            self.pending.pop(key, None)
            c = st.get("content")
            if isinstance(c, list):
                c = "\n".join(x.get("text", f"[{x.get('type')}]") for x in c if isinstance(x, dict))
            c = c or st.get("output") or st.get("error") or ""
            c = (c if isinstance(c, str) else json.dumps(c, ensure_ascii=False)).strip()
            done_ts = self.stamp((part.get("time") or {}).get("completed") or epoch * 1000)[0]
            failed = status == "error" or meta.get("exit") not in (None, 0)
            self.ev(done_ts, "err" if failed else "out", c or "(no output)", name="Bash" if shell else name)


def clip(text, n):
    lines = text.split("\n")
    if len(lines) <= n:
        return text
    head = max(n // 3, 1)
    tail = n - head
    return "\n".join(lines[:head] + [f"… {len(lines) - n} more lines (e to expand) …"] + lines[-tail:])


# ---------------------------------------------------------------- log tabs

class LogTab:
    def __init__(self, path, label, pinned=False):
        self.path, self.label, self.pinned = path, label, pinned
        self.rows = collections.deque(maxlen=8000)
        self.pos, self.part = None, ""
        self.alive, self.pids, self.started, self.ended = False, [], None, None
        self.unread, self.bottom = 0, None

    def poll(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return 0
        first = self.pos is None
        if first:
            self.pos = max(0, size - 512 * 1024)
        if size < self.pos:
            self.pos, self.part = 0, ""
        if size == self.pos:
            return 0
        with open(self.path, "rb") as f:
            f.seek(self.pos)
            data = f.read(8 << 20)
        self.pos += len(data)
        lines = (self.part + data.decode("utf-8", "replace")).split("\n")
        self.part = lines.pop()
        if first and self.pos > len(data) and lines:
            lines.pop(0)
        for l in lines:
            l = ANSI.sub("", l)
            if "\r" in l:
                l = l.rstrip("\r").split("\r")[-1]
            self.rows.append(l)
        return len(lines)

    def all_rows(self):
        r = list(self.rows)
        if self.part:
            r.append(ANSI.sub("", self.part).split("\r")[-1])
        return r


PROC_HINT = ("Output that goes to a pipe or socket is read by another program, so obwatch can't show it. "
             "Send it to a file (e.g. `cmd 2>&1 | tee run.log`) to get a live tab.")


def pipe_readers(inodes, procs):
    """pipe:[n] -> processes that hold its read end."""
    res = collections.defaultdict(list)
    if not inodes:
        return res
    for p in procs.values():
        for fd, t in proc_fds(p["pid"]):
            if t in inodes and fd_writable(p["pid"], fd) is False and p not in res[t]:
                res[t].append(p)
    return res


class SubTab:
    """One subagent's own activity, taken from the agent's feed."""

    def __init__(self, sub, feed, expand):
        self.path, self.feed, self.expand = sub["key"], feed, expand
        self.pinned, self.alive, self.pids, self.bottom, self.unread, self.pos = False, True, [], None, 0, None
        self.started = self.ended = None
        self.seen, self.cache, self.key = 0, [], None
        self.update(sub)

    def update(self, sub):
        self.label, self.kind, self.where = sub["label"], sub["kind"], sub["where"]
        self.finished = sub["finished"]

    def poll(self):
        n = sum(1 for e in self.feed.events if e.get("src") == self.path)
        new, self.seen, self.pos = n - self.seen, n, n
        return max(new, 0)

    def all_rows(self):
        key = (self.feed.total, self.expand())
        if key != self.key:
            self.cache, self.key = self.feed.rows(self.expand(), src=self.path), key
        return self.cache


class ProcTab:
    """Every process the agent started, as a tree: CPU, memory, and where its output goes."""
    path = "__procs__"

    def __init__(self):
        self.label, self.pinned, self.alive = "Processes", True, True
        self.unread, self.bottom, self.pos = 0, None, 0
        self.started = self.ended = None
        self.pids, self.rows, self.prev, self.summary = [], [], {}, ""

    def poll(self):
        return 0

    def all_rows(self):
        return self.rows

    def cpu(self, p, now):
        prev = self.prev.get(p["pid"])
        self.prev[p["pid"]] = (p["cpu"], now, p["start"])
        if prev and prev[2] == p["start"] and now > prev[1]:
            return (p["cpu"] - prev[0]) / TICKS / (now - prev[1]) * 100
        return p["cpu"] / TICKS / max(now - p["start"], 1) * 100

    def describe_out(self, p, procs, readers, tabs):
        o = p["out"]
        if not o:
            return "no output"
        if o.startswith(("/dev/pts", "/dev/tty")):
            return "terminal"
        if o == "/dev/null":
            return "discarded (/dev/null)"
        if o.startswith("pipe:"):
            r = [q for q in readers.get(o, []) if q["pid"] != p["pid"]]
            if any(is_harness(q) for q in r):
                return f"captured by {base([q for q in r if is_harness(q)][0])}: shown in the command's tab and in Activity"
            if r:
                return "pipe -> read by " + ", ".join(f"{base(q)} ({q['pid']})" for q in r[:3]) + "  (not shown)"
            return "pipe -> another program (not shown)"
        if o.startswith("socket:"):
            par = procs.get(p["ppid"])
            if par and is_harness(par):
                return f"captured by {base(par)}: shown in the command's tab and in Activity"
            return f"socket -> probably read by {base(par)} ({par['pid']})  (not shown)" if par else "socket (not shown)"
        if o.endswith(" (deleted)"):
            return "deleted file " + o[:-10]
        if not o.startswith("/"):
            return o
        note = "  [has a tab]" if o in tabs else ""
        if base(p).startswith("python") and "-u" not in p["cmd"][1:3] and not p["unbuffered"]:
            note += "  · Python buffers file output: it arrives in chunks (use python -u)"
        return "file " + o + note

    def update(self, aps, procs, tabs, deep):
        now = time.time()
        byid = {p["pid"]: p for p in aps}
        kids, roots = collections.defaultdict(list), []
        for p in aps:
            (kids[p["ppid"]] if p["ppid"] in byid else roots).append(p)
        readers = pipe_readers({p["out"] for p in aps if p["out"] and p["out"].startswith("pipe:")}, procs) if deep else {}
        rows = [("dim", PROC_HINT), ("head", f"{'PID':>7} {'CPU':>5} {'MEM':>7} {'TIME':>6}  COMMAND")]
        total_cpu = total_mem = 0

        def walk(p, depth, parent_out):
            nonlocal total_cpu, total_mem
            c = self.cpu(p, now)
            total_cpu += c
            total_mem += p["rss"]
            via = "[systemd-run] " if p.get("via") else ""
            rows.append(("cmd" if depth == 0 else "out",
                         f"{p['pid']:>7} {c:>4.0f}% {fmt_mem(p['rss']):>7} {ago(now - p['start']):>6}  "
                         f"{'  ' * depth}{via}{pretty_cmd(p['cmd'])}"))
            if p["out"] != parent_out and deep:
                rows.append(("dim", " " * 30 + "  " * depth + "↳ output: " + self.describe_out(p, procs, readers, tabs)))
            for k in sorted(kids[p["pid"]], key=lambda q: q["start"]):
                walk(k, depth + 1, p["out"])

        for r in sorted(roots, key=lambda q: q["start"]):
            walk(r, 0, None)
        if not aps:
            rows.append(("dim", "        (no processes running)"))
        self.prev = {k: v for k, v in self.prev.items() if k in byid}
        self.rows, self.pids = rows, sorted(byid)
        self.label = f"Processes {len(aps)}" if aps else "Processes"
        cores = f" (≈{total_cpu / 100:.0f} cores)" if total_cpu >= 150 else ""
        self.summary = (f" {len(aps)} process{'es' if len(aps) != 1 else ''} · CPU {total_cpu:.0f}%{cores}"
                        f" · memory {fmt_mem(total_mem)}")


class View:
    """One agent: Activity tab, Processes tab, and a tab per output file of its running/finished commands."""

    def __init__(self, agent, pinned=()):
        self.agent = agent
        self.feed = agent.make_feed()
        self.tabs = collections.OrderedDict()
        self.ptab = self.tabs[ProcTab.path] = ProcTab()
        for p in pinned:
            self.tabs[p] = LogTab(p, os.path.basename(p), pinned=True)
        self.sel = None          # path of the selected tab, None = Activity
        self.dismissed = {}      # path -> when the user closed it; stays closed until a new process writes there
        self.act_bottom, self.act_unread = None, 0
        self.expand = False
        self.show_sub = False    # subagent lines in Activity (they also have their own tabs)
        self.rows_cache, self.rows_key = [], None

    def oc_shell_procs(self, f, aps, procs):
        """Processes of the opencode shell command whose output goes to `f`: matched by command line,
        or as the harness's child that started when the file was created."""
        cmd = self.feed.shell_cmd.get(task_id(f))
        try:
            born = os.path.getctime(f)
        except OSError:
            born = 0
        res = []
        for p in aps:
            par = procs.get(p["ppid"])
            if (cmd and cmd in (shell_arg(p), " ".join(p["cmd"]))) or \
                    (par and is_harness(par) and abs(p["start"] - born) < SAME_START):
                res.append(p)
        return res

    def is_foreground(self, f):
        """opencode keeps every command's output file; only background ones stay as tabs after they end."""
        tid = task_id(f)
        return self.agent.kind == "opencode" and tid is not None and tid not in self.feed.bg_shells

    def refresh(self, procs):
        now = time.time()
        aps = agent_procs(procs, self.agent.sessions(), self.agent)
        jobs = agent_jobs(aps)
        if self.agent.kind == "opencode":
            dirs = tuple(d + os.sep for d in self.agent.shell_dirs())
            for f in harness_writing(procs, dirs):
                jobs.setdefault(f, self.oc_shell_procs(f, aps, procs))
        self.ptab.update(aps, procs, set(jobs), deep=self.sel == ProcTab.path)
        for f, ps in list(jobs.items()):
            if f in self.dismissed:
                if started_at(f, ps) > self.dismissed[f]:
                    del self.dismissed[f]   # something new started writing here: show it again
                else:
                    del jobs[f]
        for f in self.agent.output_files():   # finished background tasks
            try:
                fresh = now - os.path.getmtime(f) < KEEP_DONE and os.path.getsize(f)
            except OSError:
                continue
            if fresh and f not in jobs and f not in self.tabs and f not in self.dismissed and not self.is_foreground(f):
                t = self.tabs[f] = LogTab(f, self.label_for(f, []))
                t.ended = os.path.getmtime(f)
        owner = {}   # pid -> task output file its shell writes to
        for f, ps in jobs.items():
            if task_id(f):
                for p in ps:
                    owner[p["pid"]] = f
        if self.agent.kind == "opencode":
            # a command that sends its output elsewhere leaves its sh_*.out unopened: link them by start time
            born = self.agent.command_starts(within=float("inf"))
            for p in aps:
                par = procs.get(p["ppid"])
                if p["pid"] not in owner and par and is_harness(par):
                    hit = [f for c, f in born if abs(c - p["start"]) < SAME_START]
                    if hit:   # several commands can start at once: prefer the one whose text matches
                        me = unquote(" ".join(p["cmd"]))
                        owner[p["pid"]] = max(hit, key=lambda f: (
                            me in unquote(self.feed.shell_cmd.get(task_id(f), "")), task_id(f) in self.feed.bg_shells))

        def task_of(ps, f=None):
            """The task output file that the shell running `ps` writes to, other than `f` itself."""
            for p in ps:
                q = p
                while q:
                    if owner.get(q["pid"], f) != f:
                        return owner[q["pid"]]
                    q = procs.get(q["ppid"])
            return None

        parents = {task_of(ps, f) for f, ps in jobs.items()} - {None}
        for f in list(jobs):   # a silent task shell whose child writes its own log: show only the log
            if f in parents and not os.path.getsize(f) and f not in self.tabs:
                del jobs[f]
        for f, ps in jobs.items():
            t = self.tabs.get(f)
            if t is None:
                t = self.tabs[f] = LogTab(f, self.label_for(f, ps, task_of(ps, f)))
            if not t.alive and not t.pinned:
                t.label = self.label_for(f, ps, task_of(ps, f))
            t.alive, t.ended = True, None
            t.pids = sorted(p["pid"] for p in ps)
            t.started = started_at(f, ps)
        for f, t in list(self.tabs.items()):
            if t is self.ptab or isinstance(t, SubTab):
                continue
            if f not in jobs and t.alive:
                t.alive, t.ended = False, now
            if t.alive or t.pinned or f == self.sel:
                continue
            short = not os.path.exists(f) or self.is_foreground(f)
            if t.ended and now - t.ended > (KEEP_GONE if short else KEEP_DONE):
                del self.tabs[f]
        self.refresh_subagents(now)
        done = [t for t in self.ordered() if not t.alive and not t.pinned and t.path != self.sel]
        for t in done[MAX_DONE:]:
            del self.tabs[t.path]

    def refresh_subagents(self, now):
        """A tab per subagent: running until its meta says finished (or it goes quiet), then kept a while."""
        for sub in self.agent.subagents():
            f, updated = sub["key"], sub["updated"]
            alive = not sub["finished"] and now - updated < TOOL_STALE
            t = self.tabs.get(f)
            if t is None:
                if f in self.dismissed or not (alive or now - updated < KEEP_DONE):
                    continue
                t = self.tabs[f] = SubTab(sub, self.feed, lambda: self.expand)
                t.started = sub["started"]
            t.update(sub)
            t.alive = alive
            t.ended = None if alive else (t.ended or updated)
        for f, t in list(self.tabs.items()):
            if isinstance(t, SubTab) and not t.alive and f != self.sel and now - (t.ended or now) > KEEP_DONE:
                del self.tabs[f]

    def ordered(self):
        """Processes, pinned tabs, then running (oldest first), then finished (most recent first)."""
        tabs = [t for t in self.tabs.values() if t is not self.ptab]
        pinned = [self.ptab] + [t for t in tabs if t.pinned]
        running = sorted((t for t in tabs if t.alive and not t.pinned), key=lambda t: t.started or 0)
        done = sorted((t for t in tabs if not t.alive and not t.pinned), key=lambda t: -(t.ended or 0))
        return pinned + running + done

    def keys(self):
        return [None] + [t.path for t in self.ordered()]

    def select(self, step=None, index=None):
        keys = self.keys()
        if index is None:
            i = keys.index(self.sel) if self.sel in keys else 0
            index = (i + step) % len(keys)
        if 0 <= index < len(keys):
            self.sel = keys[index]

    def label_for(self, f, ps, parent_task=None):
        tid = task_id(f)
        if not tid and parent_task:
            ptid = task_id(parent_task)
            if ptid in self.feed.task_desc:
                return self.feed.task_desc[ptid]
        if tid and tid in self.feed.task_desc:
            return self.feed.task_desc[tid]
        if tid:   # foreground command: name it after the agent's running Bash call
            running = [v for v in self.feed.running() if v[2] == "Bash"]
            if running:
                return running[-1][1]
        return proc_label(ps) or (f"task {tid}" if tid else os.path.basename(f))

    def poll(self):
        before = self.feed.total
        self.feed.poll()
        new = self.feed.total - before
        if new and self.sel is not None:
            self.act_unread += new
        for t in self.tabs.values():
            fresh = t.pos is None
            n = t.poll()
            if n and not fresh and self.current() is not t:
                t.unread += n

    def close(self, t):
        """Hide a tab (the process keeps running) until something new writes to its file."""
        if t is self.ptab:
            return
        self.dismissed[t.path] = time.time()
        self.tabs.pop(t.path, None)

    def current(self):
        t = self.tabs.get(self.sel)
        if t is None:
            self.sel = None
        return t

    def act_rows(self):
        key = (self.feed.total, self.expand, self.show_sub)
        if key != self.rows_key:
            self.rows_cache, self.rows_key = self.feed.rows(self.expand, main_only=not self.show_sub), key
        return self.rows_cache

    def running_count(self):
        return sum(1 for t in self.tabs.values() if t.alive and t is not self.ptab)


# ---------------------------------------------------------------- drawing

STYLES = {}


def init_colors():
    curses.start_color()
    try:
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK
    spec = dict(say=(curses.COLOR_CYAN, 0), think=(curses.COLOR_MAGENTA, 0), cmd=(curses.COLOR_YELLOW, curses.A_BOLD),
                msg=(curses.COLOR_GREEN, 0), err=(curses.COLOR_RED, 0), tool=(curses.COLOR_BLUE, curses.A_BOLD),
                out=(-1, 0), dim=(-1, curses.A_DIM), warn=(curses.COLOR_YELLOW, 0), ok=(curses.COLOR_GREEN, curses.A_BOLD))
    for i, (k, (fg, attr)) in enumerate(spec.items(), 1):
        curses.init_pair(i, fg, bg)
        STYLES[k] = curses.color_pair(i) | attr
    STYLES["head"] = curses.A_BOLD | curses.A_UNDERLINE
    curses.init_pair(20, curses.COLOR_BLACK, curses.COLOR_CYAN)
    STYLES["tabsel"] = curses.color_pair(20) | curses.A_BOLD
    curses.init_pair(21, curses.COLOR_BLACK, curses.COLOR_WHITE)
    STYLES["bar"] = curses.color_pair(21)


def put(win, y, x, text, attr=0):
    h, w = win.getmaxyx()
    if y >= h or x >= w:
        return x
    # never write into the last column: terminals differ in how they wrap there
    text = CTRL.sub("", text.replace("\t", "    "))[: max(w - x - 1, 0)]
    try:
        win.addstr(y, x, text, attr)
    except (curses.error, ValueError):
        pass
    return x + len(text)


def wrap(text, width):
    out = []
    for ln in text.split("\n"):
        ln = ln.expandtabs(4)
        while len(ln) > width:
            out.append(ln[:width])
            ln = ln[width:]
        out.append(ln)
    return out


def act_lines(row, width):
    ts, tag, style, text = row
    pre = 16
    body = wrap(text, max(width - pre, 10))
    tagstyle = {"dim": "dim", "out": "dim"}.get(style, style)
    first = [(STYLES["dim"], f"{ts:<8} "), (STYLES[tagstyle], f"{tag:<6} "), (STYLES[style], body[0])]
    return [first] + [[(0, " " * pre), (STYLES[style], b)] for b in body[1:]]


LOG_ERR = re.compile(r"\b(ERROR|FATAL|panic|panicked|Traceback|failed|error:)", re.I)
LOG_WARN = re.compile(r"\bWARN", re.I)


def log_lines(row, width):
    style = STYLES["err"] if LOG_ERR.search(row) else STYLES["warn"] if LOG_WARN.search(row) else 0
    return [[(style, l)] for l in wrap(row, width)]


def proc_lines(row, width, expand=False):
    style, text = row
    if style == "dim" and text == PROC_HINT or expand:
        return [[(STYLES[style], l)] for l in wrap(text, width)]
    return [[(STYLES[style], text)]]


def draw_body(win, top, height, width, rows, bottom, render, from_top=False):
    """Render logical rows so that row `bottom` (None = last) ends at the bottom of the area.
    With `from_top`, bottom=None shows the first rows instead (for tables rather than logs)."""
    if not rows:
        put(win, top, 1, "(nothing yet)", STYLES["dim"])
        return
    width -= 1   # put() leaves the last column empty
    lines = []
    if from_top and bottom is None:
        for r in rows:
            lines += render(r, width)
            if len(lines) >= height:
                break
        lines = lines[:height]
    else:
        end = len(rows) - 1 if bottom is None else max(0, min(bottom, len(rows) - 1))
        i = end
        while i >= 0 and len(lines) < height:
            lines[0:0] = render(rows[i], width)
            i -= 1
    for y, segs in enumerate(lines[-height:]):
        x = 0
        for attr, s in segs:
            x = put(win, top + y, x, s, attr)


def draw_view(win, v):
    h, w = win.getmaxyx()
    win.erase()
    now = time.time()
    age = now - v.agent.last_write()
    running = v.feed.running()
    state = "working" if age < 20 or running else f"idle {ago(age)}"
    ndone = len(v.tabs) - 1 - v.running_count()
    hdr = f" {v.agent.name} · {state} · {v.running_count()} running · {ndone} finished"
    if running:
        hdr += f" · now: {running[-1][1]} ({ago(now - running[-1][0])})"
    put(win, 0, 0, hdr.ljust(w), STYLES["bar"])

    # tab bar: Activity | running ... ┃ finished ...
    order = v.ordered()
    items = [(None, "1 Activity" + (f" +{v.act_unread}" if v.act_unread else ""))]
    for i, t in enumerate(order, 2):
        mark = ("⚙" if t is v.ptab else "≡" if t.pinned else ("↳" if isinstance(t, SubTab) else "") +
                ("●" if t.alive else "✓"))
        lab = t.label if len(t.label) <= 26 else t.label[:25] + "…"
        unread = f" +{t.unread}" if 0 < t.unread < 1000 else " +999" if t.unread else ""
        items.append((t, f"{i if i <= 9 else ''} {mark} {lab}".strip() + unread))
    sel_i = next((i for i, (t, _) in enumerate(items) if (t.path if t else None) == v.sel), 0)
    first_done = next((t for t in order if not t.alive and not t.pinned), None)
    cells = [(t, f" {lab} ", "┃" if t is first_done and t is not None else "│") for t, lab in items]
    # pick a window of tabs around the selection that fits the width
    lo = hi = sel_i
    used = len(cells[sel_i][1]) + 1
    while True:
        grew = False
        for j in (hi + 1, lo - 1):
            if 0 <= j < len(cells) and (j > hi or j < lo) and used + len(cells[j][1]) + 1 <= w - 8:
                used += len(cells[j][1]) + 1
                lo, hi = min(lo, j), max(hi, j)
                grew = True
        if not grew:
            break
    x = put(win, 1, 0, f"«{lo} " if lo else "", STYLES["dim"])
    for i in range(lo, hi + 1):
        t, lab, sep = cells[i]
        if i > lo or lo:
            x = put(win, 1, x, sep, STYLES["warn"] if sep == "┃" else STYLES["dim"])
        st = STYLES["tabsel"] if i == sel_i else (0 if t is None or t is v.ptab else STYLES["ok"] if t.alive else STYLES["dim"])
        x = put(win, 1, x, lab, st)
    if hi < len(cells) - 1:
        put(win, 1, x, f" {len(cells) - 1 - hi}»", STYLES["dim"])

    t = v.current()
    top, bottom_row = 2, h - 1
    if t is None:
        follow = v.act_bottom is None
        draw_body(win, top, bottom_row - top, w, v.act_rows(), v.act_bottom, act_lines)
    elif isinstance(t, SubTab):
        state = f"running {ago(now - (t.started or now))}" if t.alive else f"finished {ago(now - (t.ended or now))} ago"
        put(win, 2, 0, f" subagent · {t.kind} · {state} · {t.where}".ljust(w), STYLES["dim"] | curses.A_REVERSE)
        follow = t.bottom is None
        draw_body(win, 3, bottom_row - 3, w, t.all_rows(), t.bottom, act_lines)
    elif t is v.ptab:
        put(win, 2, 0, t.summary.ljust(w), STYLES["dim"] | curses.A_REVERSE)
        follow = t.bottom is None
        draw_body(win, 3, bottom_row - 3, w, t.all_rows(), t.bottom, lambda r, wd: proc_lines(r, wd, v.expand),
                  from_top=True)
    else:
        if t.alive:
            pids = f" · pid {','.join(map(str, t.pids[:4]))}" if t.pids else ""
            info = f" running {ago(now - t.started)}{pids} · {t.path}"
        else:
            info = f" finished {ago(now - (t.ended or now))} ago · {t.path}"
        put(win, 2, 0, info.ljust(w), STYLES["dim"] | curses.A_REVERSE)
        follow = t.bottom is None
        draw_body(win, 3, bottom_row - 3, w, t.all_rows(), t.bottom, log_lines)
    foot = (" ←/→ tabs  ↑/↓ PgUp/PgDn scroll  G follow  e expand  s subagents in Activity"
            f"{' (on)' if v.show_sub else ''}  x/X close  a agents  q quit ")
    mode = (" LIVE " if t is v.ptab else " FOLLOW ") if follow else " PAUSED (G to follow) "
    put(win, h - 1, 0, foot.ljust(w - len(mode))[: w - len(mode)], STYLES["bar"])
    put(win, h - 1, max(w - len(mode) - 1, 0), mode, STYLES["tabsel"] if follow else STYLES["err"] | curses.A_REVERSE)
    win.refresh()


def draw_picker(win, agents, sel, stats):
    h, w = win.getmaxyx()
    win.erase()
    put(win, 0, 0, " obwatch · pick an agent (↑/↓, Enter, q) ".ljust(w), STYLES["bar"])
    now = time.time()
    for i, a in enumerate(agents):
        lw, live = stats.get(a.projdir, (0, 0))
        if not a.supported:
            st = f"{a.provider}: not supported"
        elif not lw:
            st = "no sessions yet"
        else:
            st = ("working" if now - lw < 20 else f"idle {ago(now - lw)}") + (f" · {live} process{'es' if live != 1 else ''}" if live else "")
        line = f" {'›' if i == sel else ' '} {a.name:<24.24} {a.provider:<9.9} {st}"
        attr = STYLES["tabsel"] if i == sel else (STYLES["dim"] if not a.supported else 0)
        put(win, 2 + i, 0, line.ljust(w), attr)
    win.refresh()


# ---------------------------------------------------------------- main loop

def tui(stdscr, args, agents, start):
    curses.curs_set(0)
    init_colors()
    stdscr.timeout(FRAME_MS)
    views, view = {}, None
    sel = 0
    if start is not None:
        view = views[start.projdir] = View(start, args.follow)
        view.poll()
    procs, last_scan, stats, last_shown = {}, 0, {}, None
    while True:
        now = time.time()
        if now - last_scan > SCAN_EVERY:
            procs, last_scan = scan_procs(), now
            if view:
                view.refresh(procs)
            else:
                stats = {a.projdir: (a.last_write(), len({p["pid"] for p in agent_procs(procs, a.sessions(), a)
                                                           if not is_shell(p) and base(p) not in UTILS}))
                         for a in agents}
        shown = (id(view), view.sel if view else None, view.expand if view else None)
        if shown != last_shown:   # repaint fully when the screen changes, so nothing stale is left
            stdscr.clear()
            last_shown = shown
        if view:
            view.poll()
            draw_view(stdscr, view)
        else:
            draw_picker(stdscr, agents, sel, stats)
        k = stdscr.getch()
        if k == -1:
            continue
        if k in (ord("q"), ord("Q")):
            return
        if view is None:
            if k in (curses.KEY_UP, ord("k")):
                sel = max(sel - 1, 0)
            elif k in (curses.KEY_DOWN, ord("j")):
                sel = min(sel + 1, len(agents) - 1)
            elif k in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT) and agents[sel].supported:
                a = agents[sel]
                view = views.get(a.projdir) or views.setdefault(a.projdir, View(a, args.follow))
                view.poll()
                last_scan = 0
            continue
        t = view.current()
        page = max(stdscr.getmaxyx()[0] // 2, 1)
        rows_len = len(view.act_rows()) if t is None else len(t.all_rows())
        cur = (view.act_bottom if t is None else t.bottom)
        if cur is None:   # the Processes table starts at the top; everything else at the end
            cur = min(rows_len - 1, stdscr.getmaxyx()[0] - 5) if t is view.ptab else rows_len - 1
        newb = "same"
        if k in (ord("a"), 27):
            view = None
            last_scan = 0
        elif k in (9, curses.KEY_RIGHT, ord("l")):
            view.select(step=1)
        elif k in (curses.KEY_BTAB, curses.KEY_LEFT, ord("h")):
            view.select(step=-1)
        elif ord("1") <= k <= ord("9"):
            view.select(index=k - ord("1"))
        elif k in (curses.KEY_UP, ord("k")):
            newb = max(cur - 1, 0)
        elif k in (curses.KEY_DOWN, ord("j")):
            newb = cur + 1
        elif k == curses.KEY_PPAGE:
            newb = max(cur - page, 0)
        elif k in (curses.KEY_NPAGE, ord(" ")):
            newb = cur + page
        elif k in (ord("g"), curses.KEY_HOME):
            newb = 0
        elif k in (ord("G"), curses.KEY_END, ord("f")):
            newb = None
        elif k == ord("s"):
            view.show_sub = not view.show_sub
            view.act_bottom = None
        elif k == ord("e"):
            view.expand = not view.expand
            last_scan = 0
            view.act_bottom = None
        elif k == ord("x") and t is not None:
            view.select(step=-1)
            view.close(t)
        elif k == ord("X"):
            for tab in list(view.tabs.values()):
                if not tab.alive and not tab.pinned:
                    view.close(tab)
            view.current()
        if newb != "same":
            if newb is not None and newb >= rows_len - 1:
                newb = None
            if t is None:
                view.act_bottom = newb
            else:
                t.bottom = newb
        if view:
            t = view.current()
            if t is None:
                view.act_unread = 0
            else:
                t.unread = 0


def plain(agent):
    colors = dict(say="\033[36m", think="\033[35m", cmd="\033[1;33m", msg="\033[32m", err="\033[31m",
                  tool="\033[1;34m", out="", dim="\033[2m")
    feed, shown = agent.make_feed(), 0
    try:
        while True:
            feed.poll()
            rows = feed.rows(False)
            new = feed.total - shown
            for ts, tag, style, text in rows[-new:] if new and shown else rows[-40:] if new else []:
                c = colors[style]
                lines = text.split("\n")
                print(f"\033[2m{ts}\033[0m {c}{tag:<6} {lines[0]}\033[0m")
                for l in lines[1:]:
                    print(f"{' ' * 16}{c}{l}\033[0m")
            shown = feed.total
            sys.stdout.flush()
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("agent", nargs="?", help="part of the agent's name or id")
    ap.add_argument("-f", "--follow", action="append", default=[], help="pin this log file as a tab (repeatable)")
    ap.add_argument("--plain", action="store_true", help="stream the activity feed without the TUI")
    ap.add_argument("--version", action="version", version=f"obwatch {__version__}")
    args = ap.parse_args()
    args.follow = [os.path.abspath(os.path.expanduser(p)) for p in args.follow]
    agents = load_agents()
    start = None
    if args.agent:
        q = args.agent.lower()
        hits = [a for a in agents if a.name.lower() == q or a.id.lower() == q] or \
            [a for a in agents if q in (a.name + " " + a.id).lower()]   # an exact name wins over partial matches
        if len(hits) != 1:
            names = ", ".join(a.name for a in hits) if hits else ", ".join(a.name for a in agents)
            sys.exit(f"{'Several' if hits else 'No'} agents match '{args.agent}': {names}")
        start = hits[0]
        if not start.supported:
            sys.exit(f"{start.name} runs on the {start.provider} provider, which obwatch doesn't support yet.")
    if args.plain:
        if not start:
            sys.exit("--plain needs an agent name")
        return plain(start)
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(tui, args, agents, start)


if __name__ == "__main__":
    main()
